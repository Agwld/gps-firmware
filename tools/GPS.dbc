 SG_ itow_ms : 0|32@1+ (1,0) [0|604799999] "ms" DASH
 SG_ utc_hour : 32|8@1+ (1,0) [0|23] "h" DASH
 SG_ utc_min : 40|8@1+ (1,0) [0|59] "min" DASH
 SG_ utc_sec : 48|8@1+ (1,0) [0|60] "s" DASH
 SG_ time_flags : 56|8@1+ (1,0) [0|255] "" DASH

BO_ 1726 GPS_Airspeed: 8 GPS_NODE
 SG_ airspeed_mps : 0|16@1+ (0.01,0) [0|655.35] "m/s" DASH
 SG_ wind_speed_mps : 16|16@1+ (0.01,0) [0|655.35] "m/s" DASH
 SG_ wind_from_deg : 32|16@1+ (0.1,0) [0|360] "deg" DASH
 SG_ pitot_scale : 48|8@1+ (0.004,0.5) [0.5|1.52] "" DASH
 SG_ air_flags : 56|4@1+ (1,0) [0|15] "" DASH
